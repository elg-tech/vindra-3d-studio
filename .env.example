# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → anon/public key (pode ir pro navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role key
# SECRETA: usada só no servidor (página pública de orçamento). Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (local: http://localhost:3000; produção: domínio da Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
